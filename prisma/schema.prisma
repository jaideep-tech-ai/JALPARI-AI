generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ IDENTITY & ACCESS ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  emailVerified Boolean  @default(false)
  verifyToken   String?
  resetToken    String?
  resetTokenExp DateTime?
  // Role: null until selected. One of:
  // citizen | municipal | disaster | field | infra | analyst | org_admin | super_admin
  role          String?
  roleStatus    String? // APPROVED | PENDING | DEMO
  language      String   @default("en")
  organization  String?
  regionState   String?
  regionCity    String?
  onboarded     Boolean  @default(false)
  notificationsEnabled Boolean @default(true)
  mustChangePassword   Boolean @default(false)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  roleRequests  RoleRequest[]
  incidents     Incident[]        @relation("reporter")
  assignedTasks AssignedTask[]    @relation("assignee")
  notifications Notification[]
  auditEvents   AuditEvent[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RoleRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole String
  organization  String?
  note          String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime @default(now())

  @@index([status])
}

// ============ GEOGRAPHY & ASSETS ============

model Asset {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  category       String // DRAIN | CULVERT | PUMP_STATION | RESERVOIR | LOW_LYING_ZONE | RETENTION_POND
  lat            Float
  lon            Float
  city           String
  district       String?
  state          String
  vulnerability  Int      @default(3) // 1-5
  drainageCapacity String @default("MODERATE") // LOW | MODERATE | HIGH
  elevationM     Float?
  notes          String?
  lastInspectedAt DateTime?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())

  assessments     RiskAssessment[]
  recommendations Recommendation[]
  tasks           AssignedTask[]

  @@index([city])
  @@index([state])
}

// ============ INCIDENTS ============

model Incident {
  id          String   @id @default(cuid())
  title       String
  category    String // WATERLOGGING | FLOODING | DRAIN_BLOCKAGE | INFRA_DAMAGE | CONTAMINATION | OTHER
  description String
  severity    String   @default("MODERATE") // LOW | MODERATE | HIGH | CRITICAL
  status      String   @default("OPEN") // OPEN | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | CLOSED | REJECTED
  lat         Float
  lon         Float
  city        String
  state       String?
  addressNote String?
  hasPhoto    Boolean  @default(false)
  reporterId  String?
  reporter    User?    @relation("reporter", fields: [reporterId], references: [id])
  assetId     String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updates IncidentUpdate[]
  tasks   AssignedTask[]

  @@index([status])
  @@index([city])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorName String
  message    String
  newStatus  String?
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

// ============ RISK INTELLIGENCE ============

model RiskAssessment {
  id            String   @id @default(cuid())
  assetId       String?
  asset         Asset?   @relation(fields: [assetId], references: [id])
  city          String
  lat           Float
  lon           Float
  score         Int // 0-100
  severity      String // LOW | MODERATE | HIGH | CRITICAL
  factors       String // JSON array [{key,label,weight,detail}]
  confidence    Int      @default(60) // 0-100
  horizon       String   @default("48h")
  source        String   @default("JALGUARD rule engine v0.9")
  dataFreshness String
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())

  recommendations Recommendation[]

  @@index([city])
  @@index([severity])
}

model Recommendation {
  id                 String   @id @default(cuid())
  assessmentId       String?
  assessment         RiskAssessment? @relation(fields: [assessmentId], references: [id])
  assetId            String?
  asset              Asset?   @relation(fields: [assetId], references: [id])
  title              String
  actionType         String // DRAIN_INSPECTION | DRAIN_CLEANING | CULVERT_INSPECTION | WATER_LEVEL_MONITORING | FIELD_INSPECTION | PUMPING_ASSESSMENT | PREVENTIVE_MAINTENANCE | CITIZEN_ADVISORY | ESCALATION
  rationale          String
  priority           String // LOW | MEDIUM | HIGH | URGENT
  resources          String?
  estCostInr         Int?
  benefit            String?
  verificationMethod String?
  status             String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | CONVERTED | COMPLETED
  decidedBy          String?
  decidedAt          DateTime?
  isDemo             Boolean  @default(false)
  createdAt          DateTime @default(now())

  tasks AssignedTask[]

  @@index([status])
  @@index([priority])
}

// ============ FIELD OPERATIONS ============

model AssignedTask {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String // matches intervention action types
  priority        String   @default("MEDIUM")
  status          String   @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | SUBMITTED | APPROVED | REJECTED | DONE | CANCELLED
  assetId         String?
  asset           Asset?   @relation(fields: [assetId], references: [id])
  incidentId      String?
  incident        Incident? @relation(fields: [incidentId], references: [id])
  recommendationId String?
  recommendation  Recommendation? @relation(fields: [recommendationId], references: [id])
  assignedToId    String?
  assignedTo      User?    @relation("assignee", fields: [assignedToId], references: [id])
  createdById     String?
  city            String?
  dueAt           DateTime?
  evidence        String   @default("[]") // JSON [{note, hasPhoto, at, author}]
  completionNote  String?
  verifiedById    String?
  verifiedAt      DateTime?
  verificationNote String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
}

// ============ PLATFORM ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorEmail String?
  action     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model DataSource {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  provider      String
  status        String   @default("SIMULATED") // LIVE | DELAYED | STALE | UNAVAILABLE | SIMULATED
  lastSuccessAt DateTime?
  notes         String?
  sortOrder     Int      @default(0)
}
